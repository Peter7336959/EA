<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>職業衛生暴露評估與作業環境監測實務報告指引</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome 圖示 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased">

  <div class="flex h-screen overflow-hidden">
    <!-- 側邊欄：主題清單 (要求 1) -->
    <aside class="w-80 bg-slate-900 text-slate-300 flex flex-col shadow-xl z-10">
      <div class="p-5 border-b border-slate-800">
        <h1 class="text-xl font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-shield-halved text-teal-400"></i> 暴露評估實務導覽
        </h1>
        <p class="text-xs text-slate-400 mt-1">報告主題 1 至 16 索引清單</p>
      </div>
      
      <nav class="flex-1 overflow-y-auto p-3 space-y-1" id="sidebar-list">
        <!-- 由 JavaScript 動態生成目錄項 -->
      </nav>

      <div class="p-4 border-t border-slate-800 text-xs text-slate-500 text-center">
        職業安全衛生專業團隊 製作編撰
      </div>
    </aside>

    <!-- 主內容區：各主題說明與細節 (要求 2) -->
    <main class="flex-1 overflow-y-auto bg-slate-50 p-8" id="main-content">
      <!-- 預設顯示的主題內容將由 JavaScript 渲染 -->
    </main>
  </div>

  <script>
    // 報告資料集 (報告 1 - 16)
    const reportsData = [
      {
        id: 1,
        title: "報告 1：暴露評估流程圖與作業型態化學危害分析",
        subtitle: "半導體/光電廠區危害物辨識與評估流程設計",
        summary: "繪製完整暴露評估流程，並針對廠區（薄膜區、蝕刻區、黃光區）各項作業型態之化學物進行危害辨識。",
        content: `
          <div class="space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
              <h3 class="text-lg font-bold text-slate-800 mb-3 border-b pb-2"><i class="fa-solid fa-sitemap text-teal-600 mr-2"></i>暴露評估標準流程 (AIHA 策略)</h3>
              <div class="grid grid-cols-1 md:grid-cols-5 gap-3 text-center text-sm font-medium">
                <div class="bg-slate-100 p-3 rounded border border-slate-300">1. 基本資料收集<br><span class="text-xs text-slate-500">(製程/原物料/作業型態)</span></div>
                <div class="bg-slate-100 p-3 rounded border border-slate-300">2. 劃分相似暴露群<br><span class="text-xs text-slate-500">(SEG 建立)</span></div>
                <div class="bg-slate-100 p-3 rounded border border-slate-300">3. 定性/半定量發展<br><span class="text-xs text-slate-500">(初步暴露剖面)</span></div>
                <div class="bg-slate-100 p-3 rounded border border-slate-300">4. 定量監測採樣<br><span class="text-xs text-slate-500">(驗證與數據分析)</span></div>
                <div class="bg-slate-100 p-3 rounded border border-slate-300">5. 暴露控制與再評估<br><span class="text-xs text-slate-500">(持續改善機制)</span></div>
              </div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
              <h3 class="text-lg font-bold text-slate-800 mb-4 border-b pb-2"><i class="fa-solid fa-table text-teal-600 mr-2"></i>廠區作業型態危害物彙整表</h3>
              <div class="overflow-x-auto">
                <table class="w-full text-sm text-left border-collapse border border-slate-300">
                  <thead class="bg-slate-800 text-white">
                    <tr>
                      <th class="border border-slate-300 px-4 py-2">Area</th>
                      <th class="border border-slate-300 px-4 py-2">作業型態</th>
                      <th class="border border-slate-300 px-4 py-2">類型</th>
                      <th class="border border-slate-300 px-4 py-2">危害物種類</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr class="bg-white"><td class="border border-slate-300 px-4 py-2 font-semibold" rowspan="5">薄膜區</td><td class="border border-slate-300 px-4 py-2">平時</td><td class="border border-slate-300 px-4 py-2">區內所有機台</td><td class="border border-slate-300 px-4 py-2 text-slate-400">—</td></tr>
                    <tr class="bg-slate-50"><td class="border border-slate-300 px-4 py-2" rowspan="3">PM</td><td class="border border-slate-300 px-4 py-2">金屬沉積機台</td><td class="border border-slate-300 px-4 py-2">Metal</td></tr>
                    <tr class="bg-slate-50"><td class="border border-slate-300 px-4 py-2">ITO 機台</td><td class="border border-slate-300 px-4 py-2">Metal</td></tr>
                    <tr class="bg-slate-50"><td class="border border-slate-300 px-4 py-2">CVD 機台</td><td class="border border-slate-300 px-4 py-2">SiH₄、NH₃、PH₃、NF₃、N₂O</td></tr>
                    <tr class="bg-white"><td class="border border-slate-300 px-4 py-2">Local Scrubber</td><td class="border border-slate-300 px-4 py-2">進氣 / 排氣</td><td class="border border-slate-300 px-4 py-2">SiH₄</td></tr>
                    
                    <tr class="bg-slate-50"><td class="border border-slate-300 px-4 py-2 font-semibold" rowspan="7">蝕刻區</td><td class="border border-slate-300 px-4 py-2">玻璃材質清洗</td><td class="border border-slate-300 px-4 py-2">—</td><td class="border border-slate-300 px-4 py-2 text-slate-400">—</td></tr>
                    <tr class="bg-white"><td class="border border-slate-300 px-4 py-2" rowspan="2">Dry Etch</td><td class="border border-slate-300 px-4 py-2">一般作業</td><td class="border border-slate-300 px-4 py-2 text-slate-400">—</td></tr>
                    <tr class="bg-white"><td class="border border-slate-300 px-4 py-2">PM (週)</td><td class="border border-slate-300 px-4 py-2">Cl₂、SF₆、O₂、N₂、酒精</td></tr>
                    <tr class="bg-slate-50"><td class="border border-slate-300 px-4 py-2" rowspan="3">濕蝕刻/剝離</td><td class="border border-slate-300 px-4 py-2">ITO film 去除</td><td class="border border-slate-300 px-4 py-2">H₂CrO₄ (鉻酸)</td></tr>
                    <tr class="bg-slate-50"><td class="border border-slate-300 px-4 py-2">Metal film 去除</td><td class="border border-slate-300 px-4 py-2">HNO₃、H₃PO₄、CH₃COOH</td></tr>
                    <tr class="bg-slate-50"><td class="border border-slate-300 px-4 py-2">Nitride film 去除</td><td class="border border-slate-300 px-4 py-2">HF (氫氟酸)</td></tr>
                    <tr class="bg-white"><td class="border border-slate-300 px-4 py-2">Stripper 去除</td><td class="border border-slate-300 px-4 py-2">—</td><td class="border border-slate-300 px-4 py-2">DMSO、NH₃、單乙醇胺</td></tr>

                    <tr class="bg-slate-50"><td class="border border-slate-300 px-4 py-2 font-semibold" rowspan="2">黃光區</td><td class="border border-slate-300 px-4 py-2">正常作業</td><td class="border border-slate-300 px-4 py-2">—</td><td class="border border-slate-300 px-4 py-2 text-slate-400">—</td></tr>
                    <tr class="bg-white"><td class="border border-slate-300 px-4 py-2">藥劑添加</td><td class="border border-slate-300 px-4 py-2">—</td><td class="border border-slate-300 px-4 py-2">HMDS</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        `
      },
      {
        id: 2,
        title: "報告 2：苯暴露證明 – 單數據與法規合規之局限性",
        subtitle: "超越法規標準，建立高信心度的統計學暴露剖面",
        summary: "說明何以單一採樣數據或僅符合國內最低法規標準，不足以向外部證明勞工暴露濃度「遠低於 OEL」。",
        content: `
          <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200 space-y-4">
            <h3 class="text-lg font-bold text-red-600"><i class="fa-solid fa-triangle-exclamation mr-2"></i>為什麼「單一數據」與「符合法規」遠遠不夠？</h3>
            <ul class="list-disc pl-6 space-y-2 text-slate-700">
              <li><strong>單一數據的代表性不足：</strong> 作業環境存在日間、季節性、作業量及操作習慣的巨大變異，單一數據無法涵蓋極端暴露狀態。</li>
              <li><strong>符合法規僅代表低限合規：</strong> 法令標準（如半年一次定點採樣）旨在確認有無違反法規上限，無法提供統計上的 95% 上信賴界限（UCL）來證明整體暴露剖面「遠低於 OEL」。</li>
            </ul>
            
            <h3 class="text-lg font-bold text-teal-700 mt-6"><i class="fa-solid fa-circle-check mr-2"></i>充分證明的規劃實務</h3>
            <ol class="list-decimal pl-6 space-y-2 text-slate-700">
              <li><strong>劃分苯作業 SEG：</strong> 針對經常接觸苯之維修與加料人員劃分相似暴露群。</li>
              <li><strong>足夠樣本數的個人採樣：</strong> 收集至少 6~10 筆以上的個人佩戴採樣數據。</li>
              <li><strong>統計分析 (AIHA 暴露分析)：</strong> 計算 95% 幾何平均數 (GM) 與幾何標準差 (GSD)，計算 **95th percentile (第95百分位數)** 與 **UTL 95%/95%**，確認極端值亦遠低於 OEL (例如 < 0.1 OEL)。</li>
              <li><strong>結合生物監測 (Biomonitoring)：</strong> 檢測尿液中 trans,trans-Muconic acid，佐證呼吸道與皮膚防護無洩漏。</li>
            </ol>
          </div>
        `
      },
      {
        id: 3,
        title: "報告 3：化學品分級管理 (CCB) 規劃與策略",
        subtitle: "無 OEL 與 有 OEL 化學品的雙軌管理體系",
        summary: "為企業設計完善的化學品分級管理機制，解決無法定容許濃度化學品的管控難題。",
        content: `
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
              <h3 class="text-lg font-bold text-amber-600 mb-3"><i class="fa-solid fa-circle-question mr-2"></i>情況 A：無容許暴露標準 (無 OEL)</h3>
              <p class="text-sm text-slate-600 mb-3">使用 **Control Banding (CCB)** 健康危害等級劃分法：</p>
              <ul class="list-disc pl-5 text-sm space-y-2 text-slate-700">
                <li><strong>健康危害等級 (Hazard Band)：</strong> 依據 SDS 的 GHS 危害警告訊息（H-Phrases / R-Phrases）劃分 A 至 E 級。</li>
                <li><strong>散播特性與使用量：</strong> 評估物質揮發度/粉塵度及每次使用量等級。</li>
                <li><strong>控制帶對應：</strong> 導出控制等級 (1: 一般通風, 2: 局部排氣, 3: 密閉製程, 4: 專家諮詢/特殊防護)。</li>
              </ul>
            </div>

            <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
              <h3 class="text-lg font-bold text-teal-600 mb-3"><i class="fa-solid fa-chart-line mr-2"></i>情況 B：有容許暴露標準 (有 OEL)</h3>
              <p class="text-sm text-slate-600 mb-3">使用 **定量監測與暴露等級 (Exposure Banding)**：</p>
              <ul class="list-disc pl-5 text-sm space-y-2 text-slate-700">
                <li><strong>等級 1 (< 0.1 OEL)：</strong> 低風險，維持現行控制與定期紀錄。</li>
                <li><strong>等級 2 (0.1 ~ 0.5 OEL)：</strong> 中風險，定期作業環境監測與健康檢查。</li>
                <li><strong>等級 3 (0.5 ~ 1.0 OEL)：</strong> 高風險，應執行工程改善、工程控制巡檢、加強防護具。</li>
                <li><strong>等級 4 (> 1.0 OEL)：</strong> 立即超標，停工檢討、實施工程徹底重構。</li>
              </ul>
            </div>
          </div>
        `
      },
      {
        id: 4,
        title: "報告 4：化學品暴露風險評估定義與方法介紹",
        subtitle: "從危害辨識到風險矩陣決策",
        summary: "系統化介紹化學品風險評估之定義、要素，並逐步說明質化與半定量評估方法。",
        content: `
          <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200 space-y-6">
            <div>
              <h3 class="text-lg font-bold text-slate-800 mb-2"><i class="fa-solid fa-book-bookmark text-teal-600 mr-2"></i>1. 風險評估的定義</h3>
              <p class="text-slate-700 text-sm leading-relaxed">
                化學品暴露風險評估（Risk Assessment）係指系統性辨識作業環境中化學物質之固有**危害性 (Hazard)**，結合勞工實際作業之**暴露量 (Exposure)**，以評估該化學品對勞工健康造成危害之**可能性 (Likelihood)** 與 **嚴重度 (Severity)** 的過程。<br>
                <span class="font-bold text-teal-700">公式化表示：Risk = Hazard × Exposure</span>
              </div>

            <div>
              <h3 class="text-lg font-bold text-slate-800 mb-2"><i class="fa-solid fa-gears text-teal-600 mr-2"></i>2. 風險評估實施步驟與方法</h3>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm mt-3">
                <div class="bg-slate-50 p-4 rounded border">
                  <h4 class="font-bold text-slate-800">步驟 A：危害性評估 (H)</h4>
                  <p class="text-xs text-slate-600 mt-1">查閱 SDS，依 GHS 分級（如致癌性、急毒性）給予 1 ~ 5 分。</p>
                </div>
                <div class="bg-slate-50 p-4 rounded border">
                  <h4 class="font-bold text-slate-800">步驟 B：暴露量評估 (E)</h4>
                  <p class="text-xs text-slate-600 mt-1">考量使用量、揮發度、作業時間、工程控制設備效能給予 1 ~ 5 分。</p>
                </div>
                <div class="bg-slate-50 p-4 rounded border">
                  <h4 class="font-bold text-slate-800">步驟 C：風險陣列判讀</h4>
                  <p class="text-xs text-slate-600 mt-1">Risk Rank = H × E，對應風險等級 (不可接受、中度、可忽略)。</p>
                </div>
              </div>
            </div>
          </div>
        `
      },
      {
        id: 5,
        title: "報告 5：相似暴露群 (SEG) 劃分實務與錯誤處置",
        subtitle: "定義、觀察數據收集與歸類錯誤更正機制",
        summary: "提供相似暴露群 (SEG) 的定義、實體觀察方法案例，並詳細說明劃分錯誤時的統計檢驗與修正流程。",
        content: `
          <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200 space-y-5">
            <div>
              <h3 class="text-lg font-bold text-slate-800 mb-1"><i class="fa-solid fa-people-group text-teal-600 mr-2"></i>1. 相似暴露群 (SEG) 的定義</h3>
              <p class="text-sm text-slate-700">指一群勞工具有相似的作業內容、使用相同的原物料與設備，且在相同的環境下工作，預期其暴露於特定危害物之濃度分佈具有統計相似性。</p>
            </div>

            <div>
              <h3 class="text-lg font-bold text-slate-800 mb-2"><i class="fa-solid fa-clipboard-list text-teal-600 mr-2"></i>2. 劃分方法與案例 (現場觀察項目)</h3>
              <div class="bg-slate-50 p-4 rounded border text-sm space-y-2">
                <p><strong>實際案例：</strong> 晶圓廠「蝕刻區 PM 維修技術員 SEG」</p>
                <p><strong>需要收集與觀察的數據：</strong></p>
                <ul class="list-disc pl-5 text-slate-600 space-y-1">
                  <li><strong>環境數據：</strong> 廠區氣流方向、換氣次數、溫濕度。</li>
                  <li><strong>製程數據：</strong> 機台型號（如 CVD vs 濕蝕刻機台）、化學品使用量。</li>
                  <li><strong>作業觀察：</strong> 人員輪班方式、實際作業時間長短、防護具佩戴一致性。</li>
                </ul>
              </div>
            </div>

            <div>
              <h3 class="text-lg font-bold text-red-600 mb-1"><i class="fa-solid fa-triangle-exclamation mr-2"></i>3. 如果劃分錯誤怎麼辦？</h3>
              <p class="text-sm text-slate-700">在定量監測後，計算其採樣數據之 **幾何標準差 (GSD)**：</p>
              <ul class="list-disc pl-5 text-sm text-slate-700 mt-2 space-y-1">
                <li>若 **GSD > 3.0**，代表該 SEG 內部的暴露變異過大，劃分錯誤。</li>
                <li><strong>處置方式：</strong> 重新檢視現場，依「作業子群」、「機台型號」或「資歷長短」進行子群拆分（Sub-grouping），重新重新監測驗證。</li>
              </ul>
            </div>
          </div>
        `
      },
      {
        id: 6,
        title: "報告 6：高數量 SEG 經費限制下之優先度選取策略",
        subtitle: "檢查員觀點：兼顧資源限制與勞工保護之展現",
        summary: "針對 125 個 SEG 但每年僅能執行 50 個採樣之資源限制，說明如何以風險排序向檢查員證明合規性。",
        content: `
          <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200 space-y-5">
            <div class="bg-teal-50 border-l-4 border-teal-500 p-4">
              <h3 class="font-bold text-teal-900">核心答覆：可以！但必須建立「風險優先順序評估 (Risk Prioritization)」機制。</h3>
            </div>

            <div>
              <h3 class="text-lg font-bold text-slate-800 mb-2"><i class="fa-solid fa-user-check text-teal-600 mr-2"></i>站在「勞動檢查員觀點」的實務展現方式</h3>
              <ol class="list-decimal pl-5 text-sm space-y-3 text-slate-700">
                <li>
                  <strong>呈現全廠 SEG 矩陣清單：</strong> 向檢查員展示全廠 125 個 SEG 均已完成**質化/半定量**風險評估，並無遺漏任何高風險區域。
                </li>
                <li>
                  <strong>透明的監測優先順序 (Prioritization Algorithm)：</strong>
                  <ul class="list-disc pl-5 text-xs text-slate-600 mt-1 space-y-1">
                    <li>優先等級 1 (15 個 SEG)：高風險/高危害性化學品（如致癌物、HF）→ 100% 每年採樣。</li>
                    <li>優先等級 2 (35 個 SEG)：中風險或暴露資訊不足者 → 納入當年採樣。</li>
                    <li>優先等級 3 (75 個 SEG)：極低風險者 → 納入 3 年輪動採樣計畫。</li>
                  </ul>
                </li>
                <li>
                  <strong>證明防護覆蓋率：</strong> 展現即使尚未監測之 SEG，均已有成熟的工程控制（如密閉化、局部排氣系統）及個體防護具（PPE）保護機制。
                </li>
              </ol>
            </div>
          </div>
        `
      },
      {
        id: 7,
        title: "報告 7：66 人 SEG 採樣規模與隨機採樣策略",
        subtitle: "樣本數計算、對象選擇與採樣實務",
        summary: "詳細規範 66 人大規模 SEG 的定量採樣人數、隨機抽樣原則與個人採樣執行細節。",
        content: `
          <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200 space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="bg-slate-50 p-4 rounded border">
                <h4 class="font-bold text-teal-700 border-b pb-1 mb-2">1. 要採集多少樣本？</h4>
                <p class="text-xs text-slate-600">依據 NIOSH / AIHA 統計規範：</p>
                <p class="text-sm font-semibold text-slate-800 mt-1">最少需要 6 ~ 10 個個案樣本。</p>
                <p class="text-xs text-slate-500 mt-1">(若要達 95% 信心水準且涵蓋第 90 百分位，至少建議 6-10 筆數據)。</p>
              </div>

              <div class="bg-slate-50 p-4 rounded border">
                <h4 class="font-bold text-teal-700 border-b pb-1 mb-2">2. 要對哪些人採樣？</h4>
                <ul class="list-disc pl-4 text-xs text-slate-600 space-y-1">
                  <li><strong>隨機抽樣 (Random Sampling)：</strong> 66 人中隨機挑選。</li>
                  <li><strong>極端值涵蓋：</strong> 包含預期暴露最高的作業人員（如資淺者、處理量最大者）。</li>
                </ul>
              </div>

              <div class="bg-slate-50 p-4 rounded border">
                <h4 class="font-bold text-teal-700 border-b pb-1 mb-2">3. 如何採樣？</h4>
                <ul class="list-disc pl-4 text-xs text-slate-600 space-y-1">
                  <li>必須採取 **個人佩戴採樣 (Personal Sampling)**，採樣介面置於呼吸帶 30 cm 內。</li>
                  <li>涵蓋全工作班（通常為 8 小時 TWA）。</li>
                </ul>
              </div>
            </div>
          </div>
        `
      },
      {
        id: 8,
        title: "報告 8：最高危險群 (Worst-Case) 採樣策略與 SEG 之比較",
        subtitle: "替代暴露評估策略之應用與差異",
        summary: "介紹 Worst-Case 採樣策略，並對比其與 SEG 採樣策略在適用時機、成本及統計學上的差異。",
        content: `
          <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200 space-y-5">
            <div>
              <h3 class="text-lg font-bold text-slate-800 mb-2"><i class="fa-solid fa-bolt text-amber-500 mr-2"></i>最高危險群策略 (Worst-Case Approach) 簡介</h3>
              <p class="text-sm text-slate-700">不進行全體統計抽樣，而是直接鎖定「最靠近污染源」、「作業量最大」、「防護最弱」的極端狀況進行檢測。若 Worst-Case 的測值仍低於容許暴露標準，則推論其他所有勞工皆安全。</p>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-sm text-left border-collapse border border-slate-300">
                <thead class="bg-slate-800 text-white">
                  <tr>
                    <th class="border border-slate-300 px-4 py-2">比較項目</th>
                    <th class="border border-slate-300 px-4 py-2">相似暴露群 (SEG) 策略</th>
                    <th class="border border-slate-300 px-4 py-2">最高危險群 (Worst-Case) 策略</th>
                  </tr>
                </thead>
                <tbody class="text-slate-700">
                  <tr class="bg-white">
                    <td class="border border-slate-300 px-4 py-2 font-semibold">目標對象</td>
                    <td class="border border-slate-300 px-4 py-2">全體勞工之代表性樣本</td>
                    <td class="border border-slate-300 px-4 py-2">預期暴露最高的個體/極端情境</td>
                  </tr>
                  <tr class="bg-slate-50">
                    <td class="border border-slate-300 px-4 py-2 font-semibold">統計推論力</td>
                    <td class="border border-slate-300 px-4 py-2">極高，可計算 95% 信賴區間與百分位數</td>
                    <td class="border border-slate-300 px-4 py-2">無統計推論力，僅能作保守判斷</td>
                  </tr>
                  <tr class="bg-white">
                    <td class="border border-slate-300 px-4 py-2 font-semibold">採樣成本</td>
                    <td class="border border-slate-300 px-4 py-2">較高 (需較多採樣數)</td>
                    <td class="border border-slate-300 px-4 py-2">較低 (採樣數很少)</td>
                  </tr>
                  <tr class="bg-slate-50">
                    <td class="border border-slate-300 px-4 py-2 font-semibold">適用時機</td>
                    <td class="border border-slate-300 px-4 py-2">大型企業、常態性作業、風險高且需精密管理</td>
                    <td class="border border-slate-300 px-4 py-2">小型企業、預算有限、或初步快篩</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        `
      },
      {
        id: 9,
        title: "報告 9：監測結果為 0 (ND / 低於定量極限) 的判讀與續作決策",
        subtitle: "定量極限 (LOQ)、未檢出 (ND) 之學理、法規與現實面剖析",
        summary: "釐清「結果為 0」的科學實質，並從學理、法規與現實營運角度解答未來是否需持續監測。",
        content: `
          <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200 space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="bg-slate-50 p-4 rounded border">
                <h4 class="font-bold text-slate-800">低於偵測極限 (LOD) vs 低於定量極限 (LOQ)</h4>
                <p class="text-xs text-slate-600 mt-1">儀器無法精確讀出數值（不代表完全沒有危害分子氣體存在）。在統計上常以 <span class="font-mono bg-amber-100 px-1">LOD / 2</span> 或 <span class="font-mono bg-amber-100 px-1">LOD / √2</span> 代入計算，絕非真正的「0」。</p>
              </div>
              <div class="bg-slate-50 p-4 rounded border">
                <h4 class="font-bold text-slate-800">未檢出 (ND, Not Detected)</h4>
                <p class="text-xs text-slate-600 mt-1">僅能代表在「當次採樣方法與檢測儀器之敏感度下」未能測得目標物。</p>
              </div>
            </div>

            <h3 class="text-lg font-bold text-slate-800 mb-1"><i class="fa-solid fa-gavel text-teal-600 mr-2"></i>以後還要不要一直持續監測？</h3>
            <div class="space-y-2 text-sm text-slate-700">
              <p><strong>1. 學理面：</strong> 若製程無變更，且數據連續多次 < 0.1 OEL (ND)，風險極低，可降低監測頻率。</p>
              <p><strong>2. 法規面：</strong> 國內《作業環境監測辦法》針對法定特化或有機溶劑，仍有「半年檢測一次」之強制規範。但可依規定申請「監測頻率寬減」（免除或延長頻率）。</p>
              <p><strong>3. 現實面：</strong> 仍需進行定期維護與走動檢查，因為密封件老化、排氣風管破損隨時可能導致 ND 變成高濃度洩漏。</p>
            </div>
          </div>
        `
      },
      {
        id: 10,
        title: "報告 10：數據異常值與極端暴露對策處置",
        subtitle: "常態極低狀況 vs 突發極高數值 (9) 之因應機制",
        summary: "針對 SEG 內 5 人監測數據（狀況一：均微量 vs 狀況二：出現高達 9 之極端值）提供分別處置指引。",
        content: `
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
              <h3 class="text-lg font-bold text-teal-700 mb-2">狀況一：極低數值 (0.01 ~ 0.03，OEL=10)</h3>
              <p class="text-xs font-semibold text-slate-500 mb-3">暴露濃度 < 0.003 OEL</p>
              <ul class="list-disc pl-5 text-sm space-y-2 text-slate-700">
                <li><strong>暴露評價：</strong> 暴露非常微弱，控制措施極為有效。</li>
                <li><strong>後續作為：</strong>
                  <ul class="list-circle pl-4 text-xs text-slate-600 mt-1 space-y-1">
                    <li>維持現有工程控制與自主稽核。</li>
                    <li>依法規頻率辦理，或評估申請監測寬減。</li>
                    <li>將資源轉移給高風險 SEG。</li>
                  </ul>
                </li>
              </ul>
            </div>

            <div class="bg-white p-6 rounded-lg shadow-sm border border-red-200">
              <h3 class="text-lg font-bold text-red-600 mb-2">狀況二：出現異常極高值 (0.1, 0.3, ... 9)</h3>
              <p class="text-xs font-semibold text-slate-500 mb-3">其中一筆達 9，逼近 OEL=10</p>
              <ul class="list-disc pl-5 text-sm space-y-2 text-slate-700">
                <li><strong>暴露評價：</strong> 存在嚴重變異或突發異常暴露事件。</li>
                <li><strong>後續作為：</strong>
                  <ol class="list-decimal pl-4 text-xs text-slate-600 mt-1 space-y-1">
                    <li><strong>根本原因分析 (RCA)：</strong> 調查該筆採樣當天是否有洩漏、異常操作、高溫烘烤或防護具破裂。</li>
                    <li><strong>確認是否為採樣污染：</strong> 檢查採樣管是否遭直接沾染。</li>
                    <li><strong>重新劃分 SEG：</strong> 若該員作業內容與其他人不同，需將其移出 SEG 獨立管理。</li>
                    <li><strong>立即工程改善與重新監測：</strong> 針對該作業檢討防護與通風。</li>
                  </ol>
                </li>
              </ul>
            </div>
          </div>
        `
      },
      {
        id: 11,
        title: "報告 11：短時間相當採樣 (STEL) 執行實務指南",
        subtitle: "資料收集、對象篩選、採樣時機點與採樣時間規範",
        summary: "解答 STEL（短時間容許濃度）監測的詳細執行方法，包含採樣時點與高於 15 分鐘作業之採樣策略。",
        content: `
          <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200 space-y-4 text-slate-700 text-sm">
            <div class="border-b pb-3">
              <h4 class="font-bold text-teal-800 text-base mb-1">1. 要收集哪些資料？</h4>
              <p>化學品 SDS (確認有無 STEL 規範)、現場作業流程圖、每日高峰作業時間（加料、清洗、拆裝機台）、局部排氣啟動時機。</p>
            </div>

            <div class="border-b pb-3">
              <h4 class="font-bold text-teal-800 text-base mb-1">2. 全部員工都要測 STEL 嗎？</h4>
              <p><strong>不需要。</strong> 僅需針對「預期發生最高衝擊性暴露（Peak Exposure）」的作業人員進行 STEL 採樣。</p>
            </div>

            <div class="border-b pb-3">
              <h4 class="font-bold text-teal-800 text-base mb-1">3. 上工時間 8 小時，要在第幾小時做測定？</h4>
              <p>不在於第幾小時，而是要在<strong>「最可能產生最高濃度的 15 分鐘區間」</strong>執行（例如：第 3 個小時執行化學品換桶加料的 15 分鐘）。</p>
            </div>

            <div>
              <h4 class="font-bold text-teal-800 text-base mb-1">4. 特定作業時間大於 15 分鐘（如作業 40 分鐘），採樣時間多久？</h4>
              <p>STEL 標準定義為 <strong>15 分鐘時間加權平均 (15-min TWA)</strong>。</p>
              <ul class="list-disc pl-5 text-xs text-slate-600 mt-1 space-y-1">
                <li>原則上仍採集 <strong>15 分鐘</strong> 樣本（選擇 40 分鐘內最劇烈的 15 分鐘）。</li>
                <li>若為評估全過程，可連續採集多支 15 分鐘採樣管，取其中最高者與 STEL 比較。</li>
              </ul>
            </div>
          </div>
        `
      },
      {
        id: 12,
        title: "報告 12：STEL 與檢查員數據之統計管理及偏差分析",
        subtitle: "95% 統計計算適用性、數據變異來源與單筆 vs 多筆統計管理",
        summary: "深入剖析 STEL 及勞檢數據是否需進行 95% 統計計算，並解析暴露變異的統計應對策略。",
        content: `
          <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200 space-y-5 text-sm text-slate-700">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="bg-slate-50 p-4 rounded border">
                <h4 class="font-bold text-slate-800">STEL 數據要進行 95% 計算嗎？</h4>
                <p class="text-xs text-slate-600 mt-1"><strong>要。</strong> 若收集多筆 STEL 數據，仍應計算第 95 百分位數或 95% UCL，以確定在最差的 15 分鐘衝擊下，極端暴露不會超過 STEL 規定。</p>
              </div>
              <div class="bg-slate-50 p-4 rounded border">
                <h4 class="font-bold text-slate-800">檢查員監測數據要進行 95% 計算嗎？</h4>
                <p class="text-xs text-slate-600 mt-1"><strong>檢查員現場不要，但事業單位內部要。</strong> 檢查員採單點開罰（天秤原則），只要單筆 > OEL 即屬違法；但事業單位預防管理需利用 95% 統計確保長期合規。</p>
              </div>
            </div>

            <div>
              <h3 class="text-base font-bold text-slate-800 mb-2"><i class="fa-solid fa-chart-simple text-teal-600 mr-2"></i>偏差 (Variability) 的類型與統計管理</h3>
              <ul class="list-disc pl-5 space-y-2">
                <li>
                  <strong>多筆數據中間的偏差（組間/組內變異）：</strong>
                  <p class="text-xs text-slate-600">原因來自環境氣流、季節、個體操作習慣差異。使用 **幾何標準差 (GSD)** 與 Log-normal 轉換管理。</p>
                </li>
                <li>
                  <strong>單一筆數據可能有的偏差（檢測誤差）：</strong>
                  <p class="text-xs text-slate-600">原因來自採樣幫浦流量漂移、分析儀器誤差。使用 **95% 信賴下限 (LCL) / 上限 (UCL)** 來展示單筆數據的誤差範圍（如 NIOSH SAE 計算）。</p>
                </li>
              </ul>
            </div>
          </div>
        `
      },
      {
        id: 13,
        title: "報告 13：製程無變更下之年度暴露評估計畫重劃策略",
        subtitle: "基於 AIHA 暴露評估循環流程圖之決策",
        summary: "說明製程未變更時，明年是否可直接沿用舊計畫，或需依 AIHA 循環進行重新評估與抽樣調整。",
        content: `
          <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200 space-y-4">
            <div class="bg-amber-50 border-l-4 border-amber-500 p-4">
              <h3 class="font-bold text-amber-900">核心答覆：不能直接照抄「該採樣誰就採樣誰」，但不需要完全重新動工。</h3>
            </div>

            <div class="text-sm text-slate-700 space-y-3">
              <h3 class="text-base font-bold text-slate-800"><i class="fa-solid fa-rotate text-teal-600 mr-2"></i>依據 AIHA 暴露評估流程圖說明</h3>
              <ol class="list-decimal pl-5 space-y-2">
                <li><strong>Re-evaluation (再評估機制)：</strong> AIHA 流程是一個閉環循環。即使「製程沒變」，仍須確認：原料供應商有無更換？維修頻率有無增加？人員有無流動？</li>
                <li><strong>輪動採樣對象 (Rotational Sampling)：</strong> 明年採樣不可重複對「同一批人」採樣。應依據 SEG 名冊，挑選**上次未被採樣到的其他成員**進行監測，以驗證 SEG 的整體一致性。</li>
                <li><strong>數據整合更新：</strong> 將明年的新數據併入歷史資料庫，重新計算 95th Percentile，更新該 SEG 的風險分類。</li>
              </ol>
            </div>
          </div>
        `
      },
      {
        id: 14,
        title: "報告 14：暴露評估未涵蓋情境之應變與補救機制",
        subtitle: "員工反映暴露未納入與現場異味之緊急處置",
        summary: "針對未預期的化學品暴露反映（乙二醇）與現場異常異味，提供實務應變應對 SOP。",
        content: `
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
              <h3 class="text-lg font-bold text-slate-800 mb-2"><i class="fa-solid fa-user-gear text-teal-600 mr-2"></i>情境 A：員工反映接觸乙二醇但未規劃採樣</h3>
              <ol class="list-decimal pl-5 text-sm text-slate-700 space-y-2">
                <li><strong>啟動現場走動調查 (Walk-through)：</strong> 訪談該員工，了解其接觸乙二醇的實際作業動線與頻率。</li>
                <li><strong>重新審視危害辨識：</strong> 確認乙二醇是否為副產物、清洗劑或飛濺接觸。</li>
                <li><strong>補救作為：</strong> 將該作業獨立新增一個子 SEG，或納入現有 SEG 進行追加**非定期暴露採樣**。</li>
              </ol>
            </div>

            <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
              <h3 class="text-lg font-bold text-slate-800 mb-2"><i class="fa-solid fa-nose-steam text-amber-600 mr-2"></i>情境 B：採樣過程中聞到區域異味</h3>
              <ol class="list-decimal pl-5 text-sm text-slate-700 space-y-2">
                <li><strong>立即暫停與現場安檢：</strong> 使用直讀式儀器（如 PID、直讀式氣體檢測管）進行現場洩漏快搜。</li>
                <li><strong>檢查工程控制：</strong> 確認區域負壓與局部排氣風速是否正常。</li>
                <li><strong>應變採樣：</strong> 於異味處追加**定點/極端狀況採樣**，確認是否有未鑑別出的揮發性有機物 (VOCs)。</li>
              </ol>
            </div>
          </div>
        `
      },
      {
        id: 15,
        title: "報告 15：證明良好環境 – 超越法定半年監測之策略",
        subtitle: "多重輔助監測機制與自主管理體系建構",
        summary: "解析僅依據法令半年檢測兩次的缺陷，並提出結合直讀儀器、連續監測與統計學的完整證明體系。",
        content: `
          <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200 space-y-4">
            <h3 class="text-lg font-bold text-red-600"><i class="fa-solid fa-circle-xmark mr-2"></i>為什麼「一年做兩次」絕對不夠證明環境極佳？</h3>
            <p class="text-sm text-slate-700">一年兩次僅代表一年 365 天中的「2 天」狀況良好。無法排除其餘 363 天可能發生的設備老化、歲修異常或季節氣流變化。</p>

            <h3 class="text-lg font-bold text-teal-700"><i class="fa-solid fa-shield-virus mr-2"></i>應採取的完整補充策略</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
              <div class="bg-slate-50 p-3 rounded border">
                <h4 class="font-bold text-slate-800 text-sm">1. 裝設連續監測系統 (CMS)</h4>
                <p class="mt-1 text-slate-600">在關鍵區域安裝 24 小時直讀式氣體監測器，繪製全年連續濃度趨勢圖。</p>
              </div>
              <div class="bg-slate-50 p-3 rounded border">
                <h4 class="font-bold text-slate-800 text-sm">2. 導入直讀式儀器自主巡檢</h4>
                <p class="mt-1 text-slate-600">廠內安衛人員每週/每月使用 PID、FTIR 進行走動式量測並記錄。</p>
              </div>
              <div class="bg-slate-50 p-3 rounded border">
                <h4 class="font-bold text-slate-800 text-sm">3. 生物監測與健康追蹤</h4>
                <p class="mt-1 text-slate-600">結合員工特殊健檢數據與生物指標（如尿液代謝物），佐證長期零影響。</p>
              </div>
            </div>
          </div>
        `
      },
      {
        id: 16,
        title: "報告 16：作業環境監測與健康檢查之整合策略",
        subtitle: "暴露數據與健康數據互補聯動模式",
        summary: "介紹如何將作業環境監測數據與特殊健康檢查結果深度融合，實現疾病早期預警與精準預防。",
        content: `
          <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200 space-y-5">
            <h3 class="text-lg font-bold text-slate-800"><i class="fa-solid fa-heart-pulse text-teal-600 mr-2"></i>環境監測與健檢整合架構</h3>
            
            <div class="space-y-3 text-sm text-slate-700">
              <div class="flex items-start gap-3 bg-slate-50 p-3 rounded">
                <div class="bg-teal-600 text-white px-2 py-1 rounded text-xs font-bold">階段 1</div>
                <div>
                  <strong>健檢對象精準核定 (基於 SEG)：</strong>
                  <p class="text-xs text-slate-600">依據 SEG 監測結果，精確核定需要執行「特殊健康檢查」的勞工名冊，避免漏報或過度檢測。</p>
                </div>
              </div>

              <div class="flex items-start gap-3 bg-slate-50 p-3 rounded">
                <div class="bg-teal-600 text-white px-2 py-1 rounded text-xs font-bold">階段 2</div>
                <div>
                  <strong>異常趨勢雙向比對：</strong>
                  <p class="text-xs text-slate-600">若健檢發現某 SEG 勞工肝功能指標異常，立即調閱該 SEG 之環境監測歷史數據與 SDS，確認是否為有機溶劑暴露引起。</p>
                </div>
              </div>

              <div class="flex items-start gap-3 bg-slate-50 p-3 rounded">
                <div class="bg-teal-600 text-white px-2 py-1 rounded text-xs font-bold">階段 3</div>
                <div>
                  <strong>生物監測 (Biomonitoring) 結合：</strong>
                  <p class="text-xs text-slate-600">將採樣監測（空氣中濃度）與健檢生物指標（如尿液中正己烷代謝物 2,5-HD）結合，評估防護具是否佩戴妥當及是否有皮膚吸收狀況。</p>
                </div>
              </div>
            </div>
          </div>
        `
      }
    ];

    // 當前選中的報告索引
    let currentReportIndex = 0;

    // 渲染側邊欄選單 (要求 1: 呈現出報告 1~16 主題清單)
    function renderSidebar() {
      const sidebarContainer = document.getElementById('sidebar-list');
      sidebarContainer.innerHTML = '';

      reportsData.forEach((report, index) => {
        const isActive = index === currentReportIndex;
        const btn = document.createElement('button');
        btn.className = `w-full text-left p-3 rounded-lg text-sm font-medium transition-all duration-200 flex items-center justify-between ${
          isActive 
            ? 'bg-teal-600 text-white shadow-md font-semibold' 
            : 'text-slate-400 hover:bg-slate-800 hover:text-slate-200'
        }`;
        
        btn.onclick = () => {
          currentReportIndex = index;
          renderSidebar();
          renderContent();
        };

        btn.innerHTML = `
          <div class="truncate pr-2">
            <span class="text-xs opacity-75 block">報告 ${report.id}</span>
            <span class="truncate block">${report.title.split('：')[1] || report.title}</span>
          </div>
          <i class="fa-solid fa-chevron-right text-xs opacity-50"></i>
        `;

        sidebarContainer.appendChild(btn);
      });
    }

    // 渲染主內容區 (要求 2: 各主題下出現說明)
    function renderContent() {
      const mainContainer = document.getElementById('main-content');
      const report = reportsData[currentReportIndex];

      mainContainer.innerHTML = `
        <div class="max-w-4xl mx-auto space-y-6">
          <!-- 頂部標題卡片 -->
          <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
            <div class="flex items-center gap-2 text-teal-600 font-bold text-sm mb-1">
              <i class="fa-solid fa-file-lines"></i> 報告 ${report.id} 詳細說明指引
            </div>
            <h2 class="text-2xl font-bold text-slate-900">${report.title}</h2>
            <p class="text-sm text-slate-500 mt-1">${report.subtitle}</p>
            <div class="mt-4 p-3 bg-slate-50 rounded border border-slate-200 text-slate-700 text-sm">
              <span class="font-semibold text-slate-900">綱要說明：</span>${report.summary}
            </div>
          </div>

          <!-- 詳細內容 -->
          ${report.content}

          <!-- 底部分頁按鈕 -->
          <div class="flex justify-between items-center pt-4 border-t border-slate-200">
            <button 
              onclick="changeReport(-1)" 
              ${currentReportIndex === 0 ? 'disabled' : ''}
              class="px-4 py-2 bg-white border border-slate-300 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed">
              <i class="fa-solid fa-arrow-left mr-2"></i> 上一主題
            </button>
            <span class="text-xs text-slate-500 font-medium">主題 ${currentReportIndex + 1} / ${reportsData.length}</span>
            <button 
              onclick="changeReport(1)" 
              ${currentReportIndex === reportsData.length - 1 ? 'disabled' : ''}
              class="px-4 py-2 bg-teal-600 text-white rounded-lg text-sm font-medium hover:bg-teal-700 disabled:opacity-40 disabled:cursor-not-allowed">
              下一主題 <i class="fa-solid fa-arrow-right ml-2"></i>
            </button>
          </div>
        </div>
      `;
    }

    // 上下頁切換
    function changeReport(direction) {
      const newIndex = currentReportIndex + direction;
      if (newIndex >= 0 && newIndex < reportsData.length) {
        currentReportIndex = newIndex;
        renderSidebar();
        renderContent();
      }
    }

    // 初始化頁面
    window.onload = () => {
      renderSidebar();
      renderContent();
    };
  </script>
</body>
</html>